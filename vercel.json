{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.9 --activate && corepack pnpm install --no-frozen-lockfile",
  "buildCommand": "corepack pnpm --filter @workspace/wingman-sports build",
  "outputDirectory": "artifacts/wingman-sports/dist/public",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
